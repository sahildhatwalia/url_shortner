PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/linkly
# Leave REDIS_URL empty to fall back to an in-memory cache and rate limiter
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
# Public base URL of THIS server (used to build short links)
BASE_URL=http://localhost:5000
# Where the React app runs (CORS + friendly redirects)
CLIENT_URL=http://localhost:5173
